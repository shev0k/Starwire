<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Starwire's page in the iOS Settings app. These are for testing until the app's own
     settings screen gets them (phase 2 and phase 4). The keys are read in PacingPolicy.m and
     Logger.m, and can also be given as launch arguments, for example -StarwireDropPolicy newest. -->
<plist version="1.0">
<dict>
	<key>PreferenceSpecifiers</key>
	<array>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Host</string>
			<key>FooterText</key>
			<string>Vibeshine only. Streams a virtual display at your stream's resolution and frame rate instead of the PC's monitor.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Use a virtual display</string>
			<key>Key</key>
			<string>StarwireVirtualDisplay</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Display</string>
			<key>FooterText</key>
			<string>Lower display refresh rates can save power at the expense of some additional video latency. Full range video loses detail in light and dark areas if the PC doesn't send it properly. Picture in picture lets you watch the stream, but not control it, while another app is open. The statistics overlay itself is turned on in the app's settings.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Allow refresh rate reduction</string>
			<key>Key</key>
			<string>StarwireReduceRefreshRate</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Picture in picture</string>
			<key>Key</key>
			<string>StarwirePictureInPicture</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Force full range video</string>
			<key>Key</key>
			<string>StarwireFullRange</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Statistics overlay</string>
			<key>Key</key>
			<string>StarwireOverlay</string>
			<key>DefaultValue</key>
			<string>full</string>
			<key>Titles</key>
			<array>
				<string>Full</string>
				<string>Lite</string>
			</array>
			<key>Values</key>
			<array>
				<string>full</string>
				<string>lite</string>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Frame pacing tests</string>
			<key>FooterText</key>
			<string>Changes apply to the next stream. The jitter buffer only works with the display driven presenter: it holds back up to 1 (low latency), 2 (balanced) or 4 (smooth) frames to ride out patchy Wi-Fi. Frames to buffer "App setting" uses the value in the app's settings.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Presenter</string>
			<key>Key</key>
			<string>StarwirePresenter</string>
			<key>DefaultValue</key>
			<string>loop</string>
			<key>Titles</key>
			<array>
				<string>Render loop (old)</string>
				<string>Display driven</string>
			</array>
			<key>Values</key>
			<array>
				<string>loop</string>
				<string>display</string>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Jitter buffer</string>
			<key>Key</key>
			<string>StarwireJitterBuffer</string>
			<key>DefaultValue</key>
			<string>balanced</string>
			<key>Titles</key>
			<array>
				<string>Lowest latency</string>
				<string>Low latency</string>
				<string>Balanced</string>
				<string>Smooth</string>
			</array>
			<key>Values</key>
			<array>
				<string>lowest-latency</string>
				<string>low-latency</string>
				<string>balanced</string>
				<string>smooth</string>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Present timing</string>
			<key>Key</key>
			<string>StarwirePresentTiming</string>
			<key>DefaultValue</key>
			<string>nearest</string>
			<key>Titles</key>
			<array>
				<string>Nearest refresh</string>
				<string>Full frame interval (old)</string>
			</array>
			<key>Values</key>
			<array>
				<string>nearest</string>
				<string>frame</string>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>When the queue is full</string>
			<key>Key</key>
			<string>StarwireDropPolicy</string>
			<key>DefaultValue</key>
			<string>alternate</string>
			<key>Titles</key>
			<array>
				<string>Alternate (old)</string>
				<string>Keep the newest</string>
			</array>
			<key>Values</key>
			<array>
				<string>alternate</string>
				<string>newest</string>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Frames to buffer</string>
			<key>Key</key>
			<string>StarwireFramesToBuffer</string>
			<key>DefaultValue</key>
			<integer>0</integer>
			<key>Titles</key>
			<array>
				<string>App setting</string>
				<string>1</string>
				<string>2</string>
				<string>3</string>
			</array>
			<key>Values</key>
			<array>
				<integer>0</integer>
				<integer>1</integer>
				<integer>2</integer>
				<integer>3</integer>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Logging</string>
			<key>FooterText</key>
			<string>Writes extra detail to the system log. Takes effect the next time the app starts.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Verbose logging</string>
			<key>Key</key>
			<string>StarwireVerboseLogging</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
	</array>
</dict>
</plist>
