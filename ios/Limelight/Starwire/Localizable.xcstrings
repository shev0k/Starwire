          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer uw firewall en port forwarding regels voor de poort(en):"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź zaporę sieciową i reguły przekierowania portów:"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique o firewall e permita a(s) seguinte(s) para porta(s):"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
