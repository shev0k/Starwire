        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Computer is currently in a game. You must close the game before pairing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ordenador está actualmente en un juego. Debes cerrar el juego antes de emparejar."
