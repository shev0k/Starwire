    "pair_pc_ingame" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Компютърът в момента е в игра. Трябва да затворите играта преди сдвояването."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na počítači momentálně běží hra. Před párováním musíte hru zavřít."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
