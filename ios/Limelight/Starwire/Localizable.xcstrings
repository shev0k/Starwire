    "custom_vulkan_driver_warning_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This loads a graphics driver file that you choose into Starwire. It's only used for PyroWave streams.\n\nThe driver runs as part of Starwire, with the same access as the app: your network, your microphone if you've allowed it, and the keys for your paired PCs. Only use a driver file from a source you trust.\n\nIf the driver can't load or can't run PyroWave, Starwire goes back to the normal driver. A driver that crashes closes Starwire instead.\n\nThis is experimental and hasn't been tried with a real Turnip driver yet."
          }
        }
      }
    },
