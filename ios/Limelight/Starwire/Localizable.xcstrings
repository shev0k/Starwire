    "summary_vban_setup" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not encrypted: anyone on the same network can listen to your microphone or send sound into the PC's microphone. Use it only for Voicemeeter or another VBAN app, on a network you trust. Set it to receive stream %2$@ from %1$@ (or this device's VPN address over a VPN), port %3$d, and play it into CABLE Input; then choose CABLE Output as the microphone in Discord or the game. Tap for the guide."
          }
        }
      }
    },
    "summary_vban_stream_name" : {
