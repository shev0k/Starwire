    "addpc_wrong_sitelocal" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този адрес не изглежда правилен. Трябва да използвате публичния IP адрес на рутера си, за да имате достъп през Интернет."
