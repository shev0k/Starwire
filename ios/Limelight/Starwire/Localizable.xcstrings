    "summary_custom_vulkan_driver" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not yet tried with a real Turnip driver. Loads a Vulkan driver file you choose, such as Turnip, for PyroWave on 64-bit ARM devices with Android 10 or newer; other codecs keep the system driver. If the driver can't load or can't run PyroWave, the system driver is used instead, but a driver that crashes closes Starwire. Restart Starwire after changing it."
          }
        }
      }
    },
    "summary_custom_vulkan_driver_file" : {
      "extractionState" : "manual",
      "localizations" : {
