    "applist_quit_confirmation" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наистина ли искате да затворите работещото приложение? Всички незапазени данни ще бъдат загубени."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
