        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你確定要刪除這台電腦？"
          }
        }
      }
    },
    "dialog_text_reset_osc" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наистина ли искате да изтриете запазената подредба на екранните елементи за управление?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jste si jisti, že chcete smazat vaše uložené rozložení ovladače?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bist du sicher, dass du das gespeicherte On-Screen-Controllertsten Layout löschen willst?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είστε βέβαιοι ότι θέλετε να διαγράψετε την αποθηκευμένη διάταξη στοιχείων ελέγχου στην οθόνη;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to delete your saved on-screen controls layout?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Estás seguro de que quieres eliminar tus configuraciones guardadas para las plantillas de los controles en pantalla?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Êtes-vous sûr de vouloir supprimer votre disposition de commandes à l'écran ?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biztosan törlöd a képernyőn megjelenő vezérlők mentett elrendezését?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakin ingin menghapus tata letak kontrol di layar yang tersimpan?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sicuro di voler ripristinare ai valori predefiniti i layout dei controlli a schermo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本当にデフォルトに戻しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 가상 컨트롤러 배치를 초기화 하시겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på at du vil slette oppsettet ditt for innstillingskontroller som vises på skjermen?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bent u zeker dat u uw opgeslagen on-screen controle-elementen wilt verwijderen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy na pewno chcesz usunąć zapisany układ kontrolek ekranowych?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem certeza de que deseja apagar o layout salvo dos controles de ecrã?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem certeza de que deseja excluir o layout salvo dos controles de tela?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigur dorești să ștergi schema salvată a controalelor de pe ecran?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы уверены что хотите удалить сохраненную схему расположения кнопок?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Är du säker på att du vill ta bort din sparade layout för skärmenheterna?"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் சேமித்த திரை கட்டுப்பாட்டு தளவமைப்பை நீக்க விரும்புகிறீர்களா?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydedilmiş ekran kontrolleri düzeninizi silmek istediğinizden emin misiniz?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви впевнені що хочете видалити збережене розташування ґудзиків?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có chắc bạn muốn xoá bố cục điều khiển trên màn hình đã lưu của bạn không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你确定要删除所保存的屏幕按钮布局吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你確定要刪除已儲存的螢幕按鈕版面配置嗎？"
          }
        }
      }
    },
