          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresa introdusă nu pare corectă. Pentru conectare prin Internet, este nevoie de adresa publică a routerului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адрес указан неверно. Вы должны ввести публичный IP-адрес Вашего роутера для передачи через интернет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den adressen ser inte rätt ut. Du måste använda routerns offentliga IP-adress för att streama via Internet."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அந்த முகவரி சரியாகத் தெரியவில்லை. இணையத்தில் ச்ட்ரீமிங் செய்ய உங்கள் திசைவியின் பொது ஐபி முகவரியைப் பயன்படுத்த வேண்டும்."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu adres doğru görünmüyor. İnternet üzerinden akış için yönlendiricinizin genel IP adresini kullanmanız gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вказана адреса неправильна. Ви повинні ввести публічну IP-адресу вашого мережника (роутера) для передачі через інтернет."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Địa chỉ đó trông không đúng. Bạn phải sử dụng địa chỉ IP công khai của router để stream qua Internet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
