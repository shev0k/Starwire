        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αύξηση για πιο ομαλή ροή βίντεο. Μειώστε για καλύτερες επιδόσεις σε συσκευές χαμηλότερων προδιαγραφών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
