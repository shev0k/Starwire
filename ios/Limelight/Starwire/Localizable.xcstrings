    "error_usb_prohibited" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достъпът до USB е забранен от администратора на устройството. Проверете настройките на Knox или MDM."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Správce zařízení neumožňuje přístup k USB. Zkontrolujte nastavení Knoxu nebo MDM."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB Zugriff ist administrativ unterbunden. Bitte überprüfen sie ihre Knox oder MDM Einstellungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πρόσβαση μέσω USB απαγορεύεται από το διαχειριστή της συσκευής σας. Ελέγξτε τις ρυθμίσεις Knox ή MDM."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB access is prohibited by your device administrator. Check your Knox or MDM settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a USB está restringido en tu dispositivo por el administrador. Revisar tus ajustes en MDM o Knox."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès USB est interdit par l'administrateur de votre appareil. Vérifiez vos paramètres Knox ou MDM."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גישה למכשירי USB נעולה על ידי מנהל המחשב. בדוק הגדרות knox או MDM."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az USB-hozzáférést az eszköz rendszergazdája tiltja. Ellenőrizze a Knox vagy az MDM beállításait."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses USB dilarang oleh Administrator perangkat Anda. Cek pengaturan Knox atau MDM Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso USB è vietato dall'amministratore del dispositivo. Verifica le impostazioni Knox o MDM."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USBへのアクセスはデバイス管理者によって禁止されています。KnoxまたはMDM設定を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 관리자에 의해 USB 액세스가 차단되었습니다. Knox 또는 MDM 설정을 확인하십시오."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsu ierīces administrators aizliedzis piekļuvi USB. Pārbaudiet savus Knox vai MDM iestatījumus."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-tilgang har blitt forbudt av din enhetsadministrator. Sjekk dine Knox- eller MDM-innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-toegang is uitgeschakeld door uw systeemadministrator. Controleer uw Knox of MDM instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostęp USB jest zabroniony przez administratora urządzenia. Sprawdź ustawienia Knox lub MDM."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso USB é proibido pelo administrador do seu aparelho. Verifique as suas configurações de Knox ou MDM."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso USB é proibido pelo administrador do seu dispositivo. Verifique suas configurações de Knox ou MDM."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesul USB este interzis de către administratorul dispozitivului. Verifică setarile Knox sau MDM."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB доступ запрещён администратором устройства. Проверьте настройки Knox или MDM."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-åtkomst är förbjuden av enhetens administratör. Kontrollera dina Knox- eller MDM-inställningar."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் சாதன நிர்வாகியால் யூ.எச்.பி அணுகல் தடைசெய்யப்பட்டுள்ளது. உங்கள் நாக்ச் அல்லது எம்.டி.எம் அமைப்புகளை சரிபார்க்கவும்."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB erişimi cihaz yöneticiniz tarafından yasaklanmıştır. Knox veya MDM ayarlarınızı kontrol edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB доступ заборонений адміністратором пристрою. Перевірте налаштування Knox або MDM."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền truy cập USB bị cấm bởi quản trị viên thiết bị. Hãy kiểm tra cài đặt Knox hoặc MDM."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备管理员已禁止USB访问。请检查您的Knox或MDM设置。"
          }
        },
        "zh-Hant" : {
