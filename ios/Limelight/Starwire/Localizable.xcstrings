          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bist du sicher, dass du die laufende App schließen möchtest? Ungespeicherte Daten gehen verloren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είστε σίγουροι ότι θέλετε να τερματίσετε την τρέχουσα εφαρμογή; Όλα τα μη αποθηκευμένα δεδομένα θα χαθούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to quit the running app? All unsaved data will be lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Estás seguro que deseas quitar la aplicación en ejecución? Todo dato sin salvar se perderá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous vraiment quitter l'application en cours d'exécution ? Toutes les données non enregistrées seront perdues."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אתה בטוח שאתה רוצה לסגור את האפליקציה הנוכחית? מידע שלא נשמר ייאבד."
