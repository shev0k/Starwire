    "check_ports_msg" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверете защитната стена и правилата за препращане на портове за следния порт или портове:"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
