    "nettest_text_inconclusive" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мрежовият тест не може да бъде извършен, защото нито един от сървърите за проверка на връзката на Moonlight не е достъпен. Проверете връзката си с Интернет или опитайте отново по-късно."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test sítě nemohl být proveden, protože se nezdařilo připoojení k žádným z testovacíh serverů Moonlight. Zkontrolujte své připojení k Internetu, nebo to zkuste znovu později."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Netzwerktest konnte nicht durchgeführt werden, da keiner der Verbindungstestserver von Moonlight erreichbar war. Überprüfe deine Internetverbindung oder versuche es später noch einmal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η δοκιμή δικτύου δεν μπορούσε να πραγματοποιηθεί επειδή κανένας από τους διακομιστές δοκιμής σύνδεσης της Moonlight δεν ήταν προσβάσιμος. Ελέγξτε τη σύνδεσή σας στο Internet ή δοκιμάστε ξανά αργότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The network test could not be performed because none of the Moonlight project's connection testing servers were reachable. Check your Internet connection or try again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prueba de red no pudo ejecutarse debido a que no se pudo alcanzar ningún servidor de prueba de conexión de Moonlight. Revisa tu conexión a internet o prueba nuevamente mas tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le test réseau n'a pas pu être effectué car aucun des serveurs de test de connexion de Moonlight n'était accessible. Vérifiez votre connexion Internet ou réessayez plus tard."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בדיקת הרשת לא התבצעה בגלל שאין קישוריות לשרתי הבדיקה של מונלייט. בבקשה בדוק את החיבור לאינטרנט או נסה שוב מאוחר יותר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hálózati tesztet nem sikerült elvégezni, mert a Moonlight egyik kapcsolat tesztelő szervere sem volt elérhető. Ellenőrizd az internetkapcsolatot, vagy próbáld újra később."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uji koneksi jaringan tidak dapat dilakukan karena tidak ada server pengujian Moonlight yang bisa dijangkau. Cek koneksi Internet Anda atau coba lagi nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il test della rete non è stato effettuato perché nessuno dei server per il test della connessione di Moonlight era raggiungibile. Controlla la tua connessione ad Internet o riprova più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonlight のコネクションテスト用のサーバーがアクセスできなかったためネットワークテストができませんでした。インターネットの接続を確認し、再度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonlight의 테스트 서버에 연결할 수 없기 때문에 네트워크 테스트를 할 수 없습니다. 인터넷 연결을 확인하거나 나중에 다시 시도하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nettverkstesten kunne ikke utføres fordi ingen av Moonlight sine tilkoblingstesttjenere kunne nås. Sjekk din tilkobling til Internett og prøv igjen senere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De netwerktest kon niet worden uitgevoerd omdat geen Moonlight netwerktesting servers bereikbaar zijn. Controleer uw internetverbinding of probeer later opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można było wykonać testu sieci ponieważ żaden z serwerów testujących połączenie Moonlight nie był osiągalny. Sprawdź połączenie internetowe lub spróbuj ponownie później."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O teste de rede não pôde ser executado porque nenhum dos servidores de teste de conexão do Moonlight estava acessível. Verifique a sua conexão com a Internet ou tente novamente mais tarde."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O teste de rede não pôde ser executado porque nenhum dos servidores de teste de conexão do Moonlight estava acessível. Verifique sua conexão com a Internet ou tente novamente mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тестирование подключения не может быть выполнено, потому что сервера тестирования подключения Moonlight не доступны. Проверьте ваше Интернет-соединение или повторите попытку позже."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nätverkstestet kunde inte utföras eftersom ingen av Moonlights servrar för anslutningstestning kunde nås. Kontrollera din internetanslutning eller försök igen senare."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பிணையம் சோதனையை செய்ய முடியவில்லை, ஏனெனில் மூன்லைட்டின் இணைப்பு சோதனை சேவையகங்கள் எதுவும் அடையப்படவில்லை. உங்கள் இணைய இணைப்பைச் சரிபார்க்கவும் அல்லது பின்னர் மீண்டும் முயற்சிக்கவும்."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moonlight'ın bağlantı testi sunucularından hiçbirine erişilemediği için ağ testi gerçekleştirilemedi. İnternet bağlantınızı kontrol edin veya daha sonra tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося перевірити мережу, тому що усі мережо-перевірочні сервери Moonlight недосяжні. Перевірте ваше з'єднання з інтернетом та спробуйте знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc thử nghiệm mạng không thể được thực hiện vì không có máy chủ thử nghiệm kết nối nào của Moonlight có thể được kết nối đến. Hãy kiểm tra kết nối Internet của bạn hoặc thử lại sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网络测试无法执行，因为无法连接到Moonlight的连接测试服务器。检查您的互联网连接或稍后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於沒有 Moonlight 連線測試伺服器可供訪問，因此無法執行網路測試。請檢查您的 Internet 連線或稍後再試。"
          }
        }
      }
    },
    "nettest_text_success" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вашата мрежа изглежда не блокира Starwire. Ако все още имате проблеми със свързването, проверете настройките на защитната стена на компютъра си.\n\nАко се опитвате да осъществите достъп през Интернет, инсталирайте „Moonlight Internet Hosting Tool“ на компютъра си и стартирайте включения тестер за достъп през Интернет, за да проверите връзката на компютъра си с Интернет."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypadá to, že vaše síť Starwire neblokuje. Pokud máte i tak potíže s připojením, zkontrolujte nastavení firewallu vašeho PC. \n \nPokud se pokoušíte streamovat po internetu, nainstalujte si na svůj počítač Moonlight Internet Hosting Tool a spusťte přiložený program Internet Streaming Tester pro kontrolu vašeho připojení k Internetu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Netzwerk scheint Starwire nicht zu blockieren. Wenn du weiterhin Probleme mit der Verbindung hast, überprüfe die Firewall-Einstellungen deines Hosts \n \nWenn du versuchst, über das Internet zu streamen, installiere das Moonlight Internet Hosting Tool auf deinem Host und führe den mitgelieferten Internet-Streaming-Tester aus, um die Internetverbindung des Hosts zu überprüfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το δίκτυό σας δεν φαίνεται να μπλοκάρει το Starwire. Αν εξακολουθείτε να έχετε πρόβλημα σύνδεσης, ελέγξτε τις ρυθμίσεις του τείχους προστασίας του υπολογιστή σας. \n \nΕάν προσπαθείτε να κάνετε streaming μέσω του Διαδικτύου, εγκαταστήστε το Moonlight Internet Hosting Tool στον υπολογιστή σας και εκτελέστε το συμπεριλαμβανόμενο Internet Streaming Tester για να ελέγξετε τη σύνδεση του υπολογιστή σας στο Διαδίκτυο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your network does not appear to be blocking Starwire. If you still have trouble connecting, check your PC's firewall settings.\n\nIf you are trying to stream over the Internet, install the Moonlight Internet Hosting Tool on your PC and run the included Internet Streaming Tester to check your PC's Internet connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu red parece no estar bloqueando Starwire. Si aun tienes problemas de conexión, comprueba la configuración del firewall de tu PC. \n \nSi estas intentado transmitir mediante Internet, instala en tu pc la Moonlight Internet Hosting Tool y ejecuta el Internet Streaming Tester incluido para comprobar la conexión de tu PC a internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre réseau ne semble pas bloquer Starwire. Si vous avez encore des difficultés à vous connecter, vérifiez les paramètres du pare-feu de votre PC. \n \nSi vous essayez de streamer depuis Internet, installez l'outil Moonlight Internet Hosting Tool sur votre PC et exécutez le testeur de streaming Internet inclus pour vérifier la connexion Internet de votre PC."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הרשת שלך איננה חוסמת את Starwire, בבקשה בדוק את הגדרות חומת האש במחשב המארח. \n \nאם אתה מנסה להזרים דרך האינטרנט, אנא התקן את הכל Moonlight Internet Hosting Tool על המחשב והפעל את כלי הבדיקה המצורף בכדי לבדוק את חיבור האינטרנט."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaringan Anda sepertinya tidak memblokir Starwire. Jika Anda masih mengalami masalah menghubungkan, cek pengaturan firewall komputer Anda. \n \nJika anda mencoba stream lewat internet, install Moonlight Internet Hosting Tool pada komputer anda dan jalankan Internet Streaming Tester untuk mengecek koneksi Internet komputer Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua rete non sembra bloccare Starwire. Se hai ancora problemi di connessione, controlla le impostazioni del firewall del PC. \n \nSe stai cercando di trasmettere via Internet, installa il Moonlight Internet Hosting Tool sul tuo PC ed avvia il Test per la trasmissione via Internet incluso per controllare la connessione ad Internet del tuo PC."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワークは Starwire をブロックしていません。接続に問題があるようでしたらコンピュータのファイアーウォールの設定を確認してください。 \n \nインターネット上でゲームをストリームする場合は Moonlight Internet Hosting Tool をインストールして付属のInternet Streaming Tester をはしらせコンピュータの接続を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크가 Starwire를 차단하지 않는 것 같습니다. 여전히 연결에 문제가 있으면 PC의 방화벽 설정을 확인하십시오 \n \n인터넷을 통해 연결하려는 경우 PC에 Moonlight Internet Hosting Tool을 설치하고 Internet Streaming Tester를 실행하여 PC의 인터넷 연결을 확인하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ser ikke ut til at nettverket ditt blokkerer Starwire. Hvis du fremdeles har problemer bør du sjekke PC-ens brannmursinnstillinger. \n \nHvis du prøver å strømme over Internett, kan du installere Moonlight Internett-vertstjeningsverktøyet på din PC og kjøre den inkluderte Internett-strømmingstesteren for å sjekke PC-ens tilkobling til Internett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw netwerk lijkt Starwire niet te blokkeren. Als u nog steeds problemen ondervindt met verbinden, controleer de firewall instellingen van uw PC. \n \nAls u probeert te streamen over het internet, installeer de Moonlight Internet Hosting Tool op uw PC en voer de inbegrepen Internet Streaming Tester uit om uw PC's internetverbinding te controleren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygląda na to, że sieć nie blokuje Starwire. Jeśli nadal masz problemy z połączeniem, sprawdź ustawienia zapory sieciowej na swoim komputerze. \n \nJeśli próbujesz przesyłać strumieniowo przez Internet, zainstaluj narzędzie Moonlight Internet Hosting Tool na swoim komputerze i uruchom dołączony tester przesyłania strumieniowego przez Internet, aby sprawdzić połączenie internetowe komputera."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua rede não parece estar a bloquear o Starwire. Se ainda tiver problemas a se conectar, verifique as configurações de firewall do seu PC. \n \nSe estiver a tentar transmitir pela Internet, instale o Moonlight Internet Hosting Tool no seu PC e execute o Internet Streaming Tester para verificar a conexão com a Internet do seu PC."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua rede não parece estar bloqueando o Starwire. Se você ainda tiver problemas para se conectar, verifique as configurações de firewall do seu PC. \n \nSe você estiver tentando transmitir pela Internet, instale o Moonlight Internet Hosting Tool em seu PC e execute o Internet Streaming Tester para verificar a conexão com a Internet do seu PC."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша сеть не блокирует Starwire. Если у вас всё ещё есть проблемы с соединением, проверьте настройки брандмауэра на компьютере.\n\nЕсли вы пытаетесь транслировать через интернет, установите Moonlight Internet Hosting Tool на ваш компьютер и запустите установленный Internet Streaming Tester, чтобы проверить Интернет-соединение на вашем компьютере."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt nätverk verkar inte blockera Starwire. Om du fortfarande har problem med anslutningen kan du kontrollera datorns brandväggsinställningar. \n \nOm du försöker streama via Internet installerar du Moonlight Internet Hosting Tool på din dator och kör den medföljande Internet Streaming Tester för att kontrollera datorns Internetanslutning."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Схоже що ваша мережа не блокує Starwire. Якщо у вас й надалі проблеми з підключенням, перевірте налаштування брандмауера. \n \nЯкщо ви намагаєтеся транслювати через Інтернет, встановіть на своєму пристрої Moonlight Internet Hosting Tool, та запустіть випробування мережі щоб перевірити ваше з'єднання до Інтернету."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mạng của bạn có vẻ là không chặn Starwire. Nếu bạn vẫn gặp rắc rối trong việc kết nối, hãy kiểm tra cài đặt tường lửa của PC. \n \nNếu bạn đang cố stream qua Internet, hãy cài đặt Moonlight Internet Hosting Tool trên PC và chạy Internet Streaming Tester được bao gồm trong đó để kiểm tra kết nối Internet của PC."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的网络似乎没有屏蔽Starwire。如果您仍然无法连接，请检查您的电脑的防火墙设置。 \n \n如果您想通过互联网进行流媒体传输，请在您的电脑上安装Moonlight互联网主机工具，并运行附带的互联网流媒体测试器来检查您的电脑的互联网连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的網路似乎沒有封鎖 Starwire。如果仍然無法連線，請檢查您電腦的防火牆設定。 \n \n如果您是嘗試透過網際網路串流，請在您的電腦上安裝 Moonlight Internet Hosting Tool，然後執行裡面的 Internet Streaming Tester 來檢查電腦的網際網路連線。"
          }
        }
      }
    },
    "nettest_text_waiting" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starwire тества мрежовата връзка, за да определи дали някой от необходимите портове не е блокиран.\n\nТова може да отнеме няколко секунди…"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starwire testuje vaše síťové připojení, aby zjistil, jestli je NVIDIA GameStream zablokován. \n \nTo může chvilku zabrat…"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starwire testet Ihre Netzwerkverbindung, um festzustellen, ob benötigte Ports blockiert sind. \n \nDies kann einige Sekunden dauern…"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Starwire δοκιμάζει τη σύνδεση δικτύου σας για να διαπιστώσει εάν κάποια θύρα είναι αποκλεισμένη. \n \n \nΑυτό μπορεί να πάρει μερικά δευτερόλεπτα…"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starwire is testing your network connection to determine if any required ports are blocked.\n\nThis may take a few seconds…"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starwire está probando tu conexión a la red para determinar si algún puerto necesario está bloqueado. \n \nEsto puede tardar unos segundos…"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starwire teste votre connexion réseau pour déterminer si les ports requis sont bloqués. \n \nCela peut prendre quelques secondes…"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starwire בודק את הרשת שלך ובודק אם ישנם פורטים הכרחיים חסומים \n \nהמתן כמה שניות…"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Starwire teszteli a hálózati kapcsolatot, hogy megállapítsa, nem blokkoltak-e szükséges portokat.\n\nEz eltarthat néhány másodpercig…"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starwire sedang menguji koneksi jaringan untuk mencari tahu apakah jalur diblokir. \n \nIni mungkin membutuhkan beberapa saat…"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starwire sta testando la tua connessione di rete per controllare se ogni porta richiesta sia bloccata. \n \nPotrebbero volerci alcuni secondi…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starwire はポートがブロックされていないか確かめるためネットワーク接続をてすとしています。 \n \n少々お待ちください…"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starwire는 필요한 포트가 차단되었는지 확인하기 위해 네트워크 연결을 테스트하고 있습니다. \n \n잠시 기다려 주세요…"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starwire tester din nettverksforbindelse for å fastsette hvorvidt NVIDIA GameStream er blokkert. \n \nDette kan ta noen sekunder …"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starwire test uw netwerkverbinding om te bepalen of er vereiste poorten geblokkeerd zijn.\n\nDit kan enkele seconden duren…"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starwire testuje połączenie sieciowe w celu ustalenia, czy wymagane porty są zablokowane. \n \nMoże to potrwać kilka sekund…"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starwire está testando sua conexão com a rede para determinar se o NVIDIA GameStream está bloqueado. \n \nEste processo pode demorar alguns segundos…"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Starwire está testando a sua conexão de internet para determinar se alguma das portas requeridas estão bloqueadas.\n\nIsso pode levar alguns segundos…"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starwire тестирует ваше сетевое подключение, чтобы определить, заблокированы ли нужные порты. \n \nЭто может занять некоторое время…"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starwire testar din nätverksanslutning för att avgöra om några nödvändiga portar är blockerade. \n \nDetta kan ta några sekunder…"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starwire, gerekli bağlantı noktalarının engellenmediğini belirlemek için ağ bağlantınızı test ediyor. \n \nBu bir kaç saniye sürebilir…"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starwire перевіряє ваше мережеве з’єднання, щоб визначити, чи заблоковані необхідні порти. \n \nЦе може зайняти кілька секунд…"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starwire đang thử nghiệm kết nối mạng của bạn để xác định xem NVIDIA GameStream có bị chặn không. \n \nViệc này có thể sẽ mất một vài giây…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starwire正在测试你的网络连接，请确保所需端口没有被屏蔽。 \n \n这可能需要几秒钟……"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starwire 正在測試您的網路連線以確認必要連接埠是否被封鎖。 \n \n可能需要等待一些時間…"
          }
        }
      }
    },
