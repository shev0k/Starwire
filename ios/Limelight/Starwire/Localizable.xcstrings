    "summary_checkbox_sync_lfr" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balanced pacing on the direct renderer: discard frames that are already stale when decoded and show only the newest. May drop more frames under load. The other pacing modes already do this."
          }
