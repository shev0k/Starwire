    "summary_analog_scrolling" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете аналогов стик, който да се ползва за превъртане като колелцето на мишката, когато се симулира мишка"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie einen Analogstick aus, der zum scrollen im Mausemulationsmodus verwendet werden soll"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select an analog stick to scroll when in mouse emulation mode"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona un joystick analógico para scroll cuando la emulación del mouse está habilitada"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séléctionner un stick analogique à utiliser pour faire défiler lors de l'émulation de la souris"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válaszd ki, melyik analóg karral szeretnél görgetni egéremulációs módban"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona uno stick analogico per scorrere durante la modalità di emulazione del mouse"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스 에뮬레이션 모드에서 스크롤할 아날로그 스틱을 선택하세요"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecteer een analoge stick om te scrollen in de muis-emulatiemodus"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybór drążka analogowego do przewijania w trybie emulacji myszy"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
