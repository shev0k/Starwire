    "host_cursor_fix_sent" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switched the PC cursor. If it's still wrong, tap Fix PC Cursor again."
          }
        }
      }
    },
    "host_cursor_reconciled" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PC cursor was left hidden last time, so Starwire turned it back on."
          }
        }
      }
    },
    "impact_actual_refresh_rate" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A wrong value makes pacing stutter. 0 measures it for you."
          }
        }
      }
    },
    "impact_async_decode" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On can cut decode delay on some devices (not measured in Starwire yet). Turn it off if video stalls."
          }
        }
      }
    },
    "impact_async_lfr" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On gives the lowest delay but can drop frames under load."
          }
        }
      }
    },
    "impact_audio_haptics" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses some battery. No change to the stream."
          }
        }
      }
    },
    "impact_audiofx" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can add audio delay. Leave it off unless you use an equalizer."
          }
        }
      }
    },
    "impact_bitrate" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higher gives a cleaner picture but needs a faster connection. Too high for your Wi-Fi causes stutter."
          }
        }
      }
    },
    "impact_custom_vulkan_driver" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimental and not yet tried with a real Turnip driver. A bad driver can close Starwire."
          }
        }
      }
    },
    "impact_deadzone" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower feels more responsive, but worn sticks may drift."
          }
        }
      }
    },
    "impact_fps" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higher is smoother and lowers latency, but uses more battery and bandwidth."
          }
        }
      }
    },
    "impact_frame_pacing" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lowest latency can tear or stutter. The smoother options add a little latency."
          }
        }
      }
    },
    "impact_hdr" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses 10-bit video, which needs hardware HEVC or AV1 decoding. Slower devices may take longer per frame."
          }
        }
      }
    },
    "impact_jitter_buffer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bigger buffer rides out patchy Wi-Fi but adds latency."
          }
        }
      }
    },
    "impact_label" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impact:"
          }
        }
      }
    },
    "impact_microphone" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses a little upload bandwidth and battery. No change to video."
          }
        }
      }
    },
    "impact_microphone_target" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Over the stream it's compressed to about 24 kbps. To a receiver on the PC it goes uncompressed, just under 1 Mbps, and only to a PC on your home network or a private VPN. Starwire's receiver gets it encrypted; the other VBAN option isn't encrypted. No change to video."
          }
        }
      }
    },
    "impact_none" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "None on speed or smoothness."
          }
        }
      }
    },
    "impact_perf_overlay" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Very small. Lite mode draws less."
          }
        }
      }
    },
    "impact_prevent_packet_loss" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For devices whose Wi-Fi naps between packets. Slightly more battery."
          }
        }
      }
    },
    "impact_pyrowave_late_frames" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accepting more blur keeps the stream smooth when frames arrive late."
          }
        }
      }
    },
    "impact_reduce_refresh_rate" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves battery but adds some latency."
          }
        }
      }
    },
    "impact_resolution" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higher is sharper but needs more bandwidth and decode time. Lower helps slower devices and networks."
          }
        }
      }
    },
    "impact_spatial_dithering" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Small GPU cost. No change to latency."
          }
        }
      }
    },
    "impact_surround" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surround uses a little more bandwidth. No change to latency."
          }
        }
      }
    },
    "impact_sync_lfr" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On lowers latency by skipping late frames. Motion can look less even under load."
          }
        }
      }
    },
    "impact_ultra_low_latency" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can lower decode latency on the chips listed. No gain on others; turn it off if video glitches."
          }
        }
      }
    },
    "impact_video_format" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HEVC and AV1 look better at the same bitrate. Older devices can take longer to decode them."
          }
        }
      }
    },
    "impact_video_renderer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vulkan paces frames more evenly for a small GPU cost. Direct has the least overhead."
          }
        }
      }
    },
    "impact_vsync" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On removes tearing but adds up to one frame of latency."
          }
        }
      }
    },
