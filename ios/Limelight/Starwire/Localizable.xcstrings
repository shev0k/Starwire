    "summary_enable_hdr" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ползване на HDR, когато играта и графичният процесор на отдалечения компютър го поддържат. HDR изисква графичен процесор, който поддържа кодиране от типа HEVC Main 10."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streamovat v HDR, pokud jej hra a GPU počítače podporují. HDR vyžaduje GPU GTX 1000 nebo novější."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streame HDR, wenn das Spiel und die PC-GPU dies unterstützen. HDR erfordert eine GPU mit HEVC Main 10-Codierungsunterstützung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μεταδώστε HDR όταν το παιχνίδι και η GPU του υπολογιστή το υποστηρίζουν. Το HDR απαιτεί GPU της σειράς GTX 1000 ή νεότερη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stream HDR / 10-bit SDR when the game and PC GPU support it. Requires a GPU with HEVC Main 10 encoding support."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transmite en HDR cuando el juego y la GPU del PC lo admitan. HDR requiere una GPU compatible con la codificación HEVC Main 10."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streamer en HDR lorsque le jeu et le GPU du PC le prennent en charge. Le HDR nécessite un GPU pouvant encoder en HEVC Main 10."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR streamelés, ha a játék és a számítógép GPU-ja támogatja. A HDR-hez HEVC Main 10 kódolási támogatással rendelkező GPU szükséges."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizza l'HDR quando il gioco e la scheda video del PC lo supportano. L'HDR richiede una scheda video col supporto dell'encoding HEVC Main 10."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임 및 PC의 GPU가 HDR을 지원하는 경우 HDR을 활성화합니다. HDR에는 HEVC Main 10 인코딩을 지원하는 GPU가 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strøm HDR når spillet og PC-ens skjermkort støtter det. HDR krever GTX 1000-eller nyere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stream HDR wanneer het spel en PC-GPU dit ondersteunen. HDR vereist een GPU met HEVC Main 10-coderingsondersteuning."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesyłaj strumieniowo HDR, gdy gra i procesor graficzny komputera obsługują tę funkcję. HDR wymaga GPU z obsługą kodowania HEVC Main 10."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transmita HDR quando o jogo e a GPU do PC suportarem. O HDR requer uma GPU da série GTX 1000 ou posterior."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transmita HDR quando o jogo e a GPU do PC suportarem. O HDR requer uma GPU da série GTX 1000 ou posterior."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosește HDR daca aplicația si placa video suportă. Necesită o placa video seria GTX 1000 sau mai nouă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потоковая передача с HDR, когда игра и графический процессор ПК поддерживают эту функцию. Для HDR требуется графический процессор с поддержкой кодирования HEVC Main 10."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strömma HDR när spelet och datorns GPU stöder det. HDR kräver en GPU med stöd för HEVC Main 10-kodning."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "விளையாட்டு மற்றும் பிசி சி.பீ.யூ அதை ஆதரிக்கும் போது ச்ட்ரீம் எச்டிஆர். எச்.டி.ஆருக்கு எச்.வி.சி முதன்மையான 10 குறியாக்க ஆதரவுடன் சி.பீ.யூ தேவைப்படுகிறது."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyun ve PC GPU desteklediğinde HDR akışı gerçekleştirin. HDR, HEVC Main 10 kodlama desteğine sahip bir GPU gerektirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Транслювати в HDR, якщо це підтримується грою та графічним процесором ПК. Для HDR потрібен графічний процесор із підтримкою кодування HEVC Main 10."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stream HDR khi trò chơi và GPU của PC hỗ trợ nó. HDR yêu cầu GPU GTX series 1000 hoặc mới hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当游戏和显卡支持时以HDR模式串流。 HDR需要显卡支持 HEVC Main 10 编码。"
