        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Augmentez pour une meilleure clarté de l'image. Réduisez pour de meilleures performances sur les appareils bas de gamme et les réseaux lents."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להגביר לשיפור איכות התמונה. להוריד לשיפור ביצועים על מערכות ישנות ורשתות איטיות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Növeld a jobb képélességhez, csökkentsd a jobb teljesítményhez az alsóbb kategóriás eszközökön és a lassabb hálózatokon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tingkatkan untuk meningkatkan kejernihan gambar. Turunkan untuk kinerja yang lebih baik pada perangkat kelas bawah dan jaringan yang lebih lambat."
