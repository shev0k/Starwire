        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumentare per migliorare la nitidezza dell'immagine. Diminuire per aumentare le prestazioni su dispositivi di fascia più bassa e reti più lente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "品質が高いほどラグとクラッシュが発生しやすくなります"
