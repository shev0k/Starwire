      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V-Sync stops tearing but can add up to one frame of delay."
          }
        }
      }
    },
    "feel_warp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PC sends twice the frames and the newest one is always shown. Lower delay, but the tablet, PC and network work harder."
          }
        }
      }
    },
    "feel_warp2" : {
      "extractionState" : "manual",
      "localizations" : {
