          "stringUnit" : {
            "state" : "translated",
            "value" : "Check your firewall and port forwarding rules for port(s):"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa la configuración de tu firewall, así como, las reglas de redireccionamiento para él(los) puerto(s):"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez vos règles de pare-feu pour les ports suivants :"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בדוק את חומת האש וניהול פורטים עבור הפורטים הבאים:"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ellenőrizd a tűzfal- és porttovábbítási beállításokat a következő port(ok) esetén:"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cek pengaturan firewall dan port forwarding untuk port-port ini:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla il tuo firewall e le regole di inoltro delle seguenti porte:"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 포트의 방화벽 및 포트 포워딩 설정을 확인하십시오:"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārbaudiet savus ugunsmūra un portu pārsūtīšanas noteikumus portam(-iem):"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
