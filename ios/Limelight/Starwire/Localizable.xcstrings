    "summary_checkbox_reduce_refresh_rate" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По-ниските честоти на опресняване на екрана могат да намалят консумацията за сметка на малко допълнително забавяне на видеото"
