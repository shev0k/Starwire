        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சுட்டி எமுலேசன் பயன்முறையில் இருக்கும்போது உருட்ட ஒரு அனலாக் குச்சியைத் தேர்ந்தெடுக்கவும்"
