            "value" : "பிசிக்கு மெதுவான இணைப்பு\n உங்கள் பிட்ரேட்டைக் குறைக்கவும்"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilgisayara yavaş bağlantı \nBit hızınızı düşürün"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повільне підключення \nЗменшіть швидкість потоку"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối đến PC bị chậm. \nHãy giảm tốc độ bit"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与电脑连接过慢 \n 请降低码率"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與電腦連線過慢 \n 請降低位元速率"
          }
        }
      }
    },
