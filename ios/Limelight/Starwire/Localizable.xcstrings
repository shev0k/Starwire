        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கம்ப்யூட்டர்மேனேசர் பணி இயங்கவில்லை. தயவுசெய்து சில வினாடிகள் காத்திருங்கள் அல்லது பயன்பாட்டை மறுதொடக்கம் செய்யுங்கள்."
          }
        },
        "tr" : {
          "stringUnit" : {
