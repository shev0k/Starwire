    "searching_pc" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Търсене на достъпни компютри в локалната мрежа…\n\n Уверете се, че Sunshine работи на отдалечения компютър, или че GameStream е включен в настройките на GeForce Experience SHIELD."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hledání PC, na kterých běží GameStream... \n \nUjistěte se, že je GameStream povolen v záložce SHIELD v nastavení GeForce Experience."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche nach Host PCs in deinem lokalen Netzwerk… \n \nStelle sicher, dass Sunshine läuft oder GameStream in den GeForce Experience SHIELD-Einstellungen aktiviert ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναζήτηση για υπολογιστές με GameStream σε λειτουργία... \n \n Βεβαιωθείτε ότι το GameStream είναι ενεργοποιημένο στις ρυθμίσεις GeForce Experience SHIELD."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Searching for host PCs on your local network…\n\n Ensure Sunshine is running on your host PC or GameStream is enabled in the GeForce Experience SHIELD settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscando anfitriones en tu red local...\n\n Asegúrate de que Sunshine se está ejecutando en el PC anfitrión o de que GameStream está activado en los ajustes de GeForce Experience SHIELD."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche de PC hôtes sur votre réseau local… \n \n Assurez-vous que Sunshine est en cours d'execution ou que GameStream est activé dans les paramètres GeForce Experience SHIELD."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחפש מחשבים ברשת המקומית שלך... \n \nוודא שסאנשיין או GeForce Experience פועלים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A helyi hálózaton lévő számítógépek keresése...\n\nGyőződj meg róla, hogy a Sunshine fut a gazdagépen, vagy a GameStream engedélyezve van a GeForce Experience SHIELD beállításaiban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mencari host PC di jaringan lokal Anda...\n\nPastikan Sunshine berjalan di PC host Anda atau GameStream diaktifkan dalam pengaturan SHIELD Pengalaman GeForce."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricerca di PC nella rete locale… \n \n Assicurati che Sunshine sia avviato o che GameStream sia abilitato nelle impostazioni SHIELD di GeForce Experience."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルネットワーク上のホストPCを検索中… \n \nホストPCでSunshineが実行中であるか、GeForce ExperienceのSHIELD設定でGameStreamが有効になっていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 네트워크의 호스트 PC를 검색중… \n \n 호스트 PC에서 Sunshine이 실행 중인지 또는 GeForce Experience SHIELD 설정에서 GameStream이 활성화되어 있는지 확인하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søker etter PC-er med GameStream kjørende … \n \nForsikre deg om at GameStream er påslått i GeForce Experience SHEILD-innstillingene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoeken naar host-PC's in uw lokale netwerk...\n\nZorg ervoor dat Sunshine draait op uw host-PC of dat GameStream is ingeschakeld in de GeForce Experience SHIELD-instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyszukiwanie komputerów-hostów w sieci lokalnej... \n \nUpewnij się, że aplikacja Sunshine jest uruchomiona na komputerze-hoście lub funkcja GameStream jest włączona w ustawieniach aplikacji GeForce Experience SHIELD."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procurando por PCs a executar o GameStream... \n \nCertifique-se de que o GameStream esteja ativado nas configurações do SHIELD do GeForce Experience."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procurando por PCs rodando o GameStream... \n \nCertifique-se de que o GameStream esteja ativado nas configurações do SHIELD do GeForce Experience."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se caută PC-uri cu GameStream activat…\n\n Asigură-te ca GameStream este activat în setările Geforce Experience SHIELD."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поиск хост-ПК в вашей локальной сети… \n \n Убедитесь, что Sunshine работает на вашем хост-компьютере или GameStream включен в настройках GeForce Experience SHIELD."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Söker efter värddatorer i det lokala nätverket... \n \n Kontrollera att Sunshine körs på värddatorn eller att GameStream är aktiverat i inställningarna för GeForce Experience SHIELD."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் உள்ளக நெட்வொர்க்கில் புரவலன் பிசிக்களைத் தேடுகிறது…\n\n உங்கள் புரவலன் கணினியில் சன்சைன் இயங்குகிறது என்பதை உறுதிப்படுத்தவும்."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel ağınızdaki ana bilgisayarlar aranıyor… \n \n Sunshine ana bilgisayarınızda çalıştığından veya GeForce Experience SHIELD ayarlarında GameStream etkinleştirildiğinden emin olun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пошук головного ПК у локальній мережі… \n \nПереконайтеся, що Sunshine запущено на вашому головному ПК або GameStream увімкнено в налаштуваннях GeForce Experience SHIELD."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang tìm các PC có GameStream đang chạy… \n \nHãy chắc chắn là GameStream được bật trong cài đặt GeForce Experience SHIELD."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你的本地网络中搜索串流主机PC... \n \n 确保Sunshine在主机上运行，或在GeForce Experience SHIELD设置中启用GameStream。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在您的區域網路中搜尋主機電腦… \n \n 請確保 Sunshine 正在您的主機電腦中執行，或在 GFE SHIELD 設定中啟用 GAMESTREAM。"
          }
        }
      }
    },
