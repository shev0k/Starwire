        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увеличение для более плавного видео потока. Уменьшите для лучшей производительности на более слабых устройствах."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öka för en jämnare videoström. Sänk för bättre prestanda på enheter med lägre prestanda."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மென்மையான வீடியோ ச்ட்ரீமுக்கு அதிகரிப்பு. கீழ் இறுதியில் சாதனங்களில் சிறந்த செயல்திறனைக் குறைத்தல்."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha akıcı bir video akışı için artırın. Düşük uçlu cihazlarda daha iyi performans için azaltın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збільшіть для плавнішого відео потоку. Зменшіть для кращої продуктивності на повільних пристроях."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tăng để stream video mượt mà hơn. Giảm để có hiệu năng tốt hơn trên các thiết bị tầm thấp hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高帧数提升视频流流畅度。低帧数提升在低端设备中的串流体验。"
