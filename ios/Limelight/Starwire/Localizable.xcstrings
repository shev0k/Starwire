    "nettest_text_blocked" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущата мрежова връзка на устройството блокира Starwire. Достъпът през Интернет може да не работи, докато компютърът е свързан към тази мрежа."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše současné připojení k síti blokuje Starwire. Streamování přes Internet nemusí fungovat, dokud jste připojeni k této síti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die aktuelle Netzwerkverbindung deines Geräts blockiert Starwire. Das Streaming über das Internet funktioniert möglicherweise nicht, während du mit diesem Netzwerk verbunden bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η τρέχουσα σύνδεση δικτύου της συσκευής σας εμποδίζει το Starwire. Η ροή μέσω του Internet ενδέχεται να μην λειτουργεί ενώ είστε συνδεδεμένοι σε αυτό το δίκτυο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your device's current network connection is blocking Starwire. Streaming over the Internet may not work while connected to this network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión de red actual de tu dispositivo esta bloqueando Starwire. La Transmisión mediante Internet puede no funcionar mientras estés conectado a esta red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion réseau actuelle de votre appareil bloque Starwire. Le streaming sur Internet peut ne pas fonctionner lorsque vous êtes connecté à ce réseau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חיבור הרשת הנוכחי חוסם את Starwire. הזרמה על גבי האינטרנט אינה אפשרית כל עוד Starwire מחובר לרשת הנוכחית."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koneksi jaringan perangkat anda memblokir Starwire. Streaming lewat Internet mungkin tidak bekerja ketika terhubung dengan jaringan ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'attuale connessione di rete del tuo dispositivo sta bloccando Starwire. Trasmettere via Internet potrebbe non funzionare mentre sei connesso a questa rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスの設定が Starwire をブロックしているようです。このネットワークに接続している間ストリーミングが使えないかもしれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기의 현재 네트워크가 Starwire를 차단하고 있습니다. 이 네트워크에 연결되어 있으면 인터넷을 통한 스트리밍이 작동하지 않을 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nettverkstilkoblingen på din enhet ser ut til å blokkere Starwire. Strømming over Internett vil muligens ikke fungere tilkoblet gjennom dette nettverket."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De internetverbinding van dit toestel blokkeert Starwire. Streamen over het internet werkt mogelijks niet wanneer u verbonden bent met dit netwerk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bieżące połączenie sieciowe urządzenia blokuje Starwire. Przesyłanie strumieniowe przez Internet może nie działać podczas połączenia z tą siecią."
          }
        },
        "pt" : {
          "stringUnit" : {
