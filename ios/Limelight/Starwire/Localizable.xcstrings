          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quell'indirizzo non sembra corretto. È necessario utilizzare l'indirizzo IP pubblico del router per lo streaming su Internet."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주소가 잘못된 것 같습니다. 인터넷을 통해 스트리밍하려면 라우터의 공용 IP 주소를 사용해야합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den adressen ser ikke riktig ut. Du må bruke den offentlige IP-adressen for ruteren din for strømming over Internett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat adres lijkt niet te kloppen. U moet het publieke IP-adres van uw router gebruiken om te kunnen streamen over het Internet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
