      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увеличете за по-плавен видео поток. Намалете за по-добра производителност на устройства от по-нисък клас."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
