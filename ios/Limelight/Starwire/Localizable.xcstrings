    "addpc_unknown_host" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адресът на компютъра не е достъпен. Уверете се, че няма грешка във въведения адрес."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezdařilo se připojit k adrese PC. Ujistěte se, že v adrese není překlep."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auflösen der Hostadresse fehlgeschlagen. Stelle sicher, dass die Adresse keine Tippfehler beinhaltet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αδυναμία επίλυσης διεύθυνσης υπολογιστή. Βεβαιωθείτε ότι δεν κάνατε τυπογραφικό λάθος στη διεύθυνση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unable to resolve PC address. Make sure you didn't make a typo in the address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposible resolver la dirección del PC. Asegúrate que no hay ningún error en la dirección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de résoudre l'adresse du PC. Assurez-vous que vous n'avez pas fait de faute de frappe dans l'adresse."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נכשל לאתר כתובת מחשב. נא לוודא שאין שגיאה בכתובת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült feloldani a számítógép azonostóját. Győződj meg arról, hogy nem írtad el a címet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat menyelesaikan alamat PC. Pastikan Anda tidak salah ketik di alamat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile risovere l'indirizzo del PC. Assicurati di aver scritto correttamente l'indirizzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータのアドレスが解決できません。コンピュータのアドレスを確認してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PC의 IP주소를 확인할 수 없습니다. 주소에 오타가 없는지 확인하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke utlede adresse tilhørende PC. Forsikre deg om at du ikke har skrevet den inn feil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adres achterhalen is mislukt. Controleer het ingevoerde adres op typfouten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można określić adresu komputera. Upewnij się, że nie popełniłeś literówki w adresie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível encontrar o PC. Certifique-se de que não cometeu um erro de digitação no endereço."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível encontrar o PC. Certifique-se de que não cometeu um erro de digitação no endereço."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu am putut identifica adresa PC-ului. Asigură-te că ai introdus-o corect."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось найти ПК по указанному адресу. Убедитесь, что Вы не совершили ошибок во время его написания."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det går inte att lösa PC-adressen. Kontrollera att du inte har skrivit fel i adressen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பிசி முகவரியை தீர்க்க முடியவில்லை. முகவரியில் நீங்கள் எழுத்துப்பிழை செய்யவில்லை என்பதை உறுதிப்படுத்திக் கொள்ளுங்கள்."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilgisayar adresi çözümlenemiyor. Adreste yazım hatası yapmadığınızdan emin olun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неможливо знайти пристрій за вказаною адресою. Переконайтеся, що ви не зробили помилок під час його написання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể xử lý địa chỉ PC. Hãy chắc chắn là bạn không mắc lỗi chính tả trong địa chỉ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
