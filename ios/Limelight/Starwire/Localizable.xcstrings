    "ios_summary_drop_policy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which frames to drop when too many are waiting. For frame pacing tests. Changes apply to the next stream."
          }
        }
      }
    },
    "ios_summary_external_display" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video on the display keeps the touch controls on this screen. Plug the display in again after changing this."
          }
        }
      }
    },
    "ios_summary_frame_interpolation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPadOS 26 or later. Adds a made-up frame between each pair, so a 60 FPS stream shows at 120 Hz, for about half a frame of extra latency. It only runs at sizes the iPad allows."
          }
        }
      }
    },
    "ios_summary_frames_to_buffer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How many decoded frames the app keeps queued. More frames ride out a patchy network but add latency."
          }
        }
      }
    },
    "ios_summary_graph_opacity" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How see-through the graphs are."
