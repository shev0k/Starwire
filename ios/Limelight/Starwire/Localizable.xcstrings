    "frame_conversion_error" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отдалеченият компютър докладва критична грешка при кодиране на видеото.\n\nОпитайте да изключите режима HDR, да промените резолюцията на потока или резолюцията на екрана на отдалечения компютър."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hostitelský počítač hlásí fatální chybu enkódování videa. \n \nZkuste vypnout HDR, změňte rozlišení streamu nebo rozlišení displeje hostitelského PC."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Host-PC hat einen schwerwiegenden Videocodierungsfehler gemeldet. \n \nVersuchen Sie, den HDR-Modus zu deaktivieren, die Streaming-Auflösung zu ändern oder die Bildschirmauflösung des Host-PCs zu ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο υπολογιστής φιλοξενίας ανέφερε ένα σφάλμα κωδικοποίησης βίντεο. \n \nΔοκιμάστε να απενεργοποιήσετε τη λειτουργία HDR, να αλλάξετε την ανάλυση ροής ή να αλλάξετε την ανάλυση οθόνης του υπολογιστή φιλοξενίας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The host PC reported a fatal video encoding error.\n\nTry disabling HDR mode, changing the streaming resolution, or changing your host PC's display resolution."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El PC anfitrión ha reportado un error fatal en el codificador de video. \n \nIntenta deshabilitar el modo HDR, cambiar la resolución de la transmisión, o cambiar la resolución de pantalla del PC anfitrión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le PC hôte a signalé une erreur d'encodage fatale. \n \nEssayez de désactiver le mode HDR, de changer la résolution du stream ou la résolution de votre PC hôte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המחשב המארח דיווח על שגיאת הצפנת וידיאו. \n \nנסה לבטל הגדרת HDR, החלפת רזולוציית הזרמה או לשנות את רזולוציית המחשב המארח."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gazdagép végzetes videokódolási hibát jelentett.\n\nPróbáld meg letiltani a HDR módot, megváltoztatni a streamelési felbontást, vagy megváltoztatni a gazdagép kijelzőjének felbontását."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PC host melaporkan kesalahan penyandian video yang fatal. \n \nCoba nonaktifkan mode HDR, ubah resolusi streaming, atau ubah resolusi tampilan PC host Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il PC host ha segnalato un errore fatale di codifica video. \n \nProva a disabilitare la modalità HDR, modificare la risoluzione dello streaming o la risoluzione del display del tuo PC host."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストPCが致命的なビデオエンコーディングエラーを報告しました。 \n \nHDRモードを無効にするか、ストリーミング解像度を変更するか、ホストPCのディスプレイ解像度を変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호스트 PC에서 치명적인 비디오 인코딩 오류를 보고했습니다. \n \nHDR 모드를 비활성화하거나 스트리밍 해상도를 변경하거나 호스트 PC의 디스플레이 해상도를 변경해 보십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De host-PC meldde een fatale videocoderingsfout.\n\nProbeer de HDR-modus uit te schakelen, de streamingresolutie te wijzigen of de schermresolutie van uw host-PC te wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komputer host zgłosił krytyczny błąd kodowania wideo. \n \nSpróbuj wyłączyć tryb HDR, zmienić rozdzielczość przesyłania strumieniowego lub rozdzielczość wyświetlacza komputera hosta."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PC host relatou um erro fatal de codificação de vídeo. \n \nTente desativar o modo HDR, alterar a resolução de streaming ou alterar a resolução do PC host."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PC host relatou um erro fatal de codificação de vídeo. \n \nTente desativar o modo HDR, alterar a resolução de streaming ou alterar a resolução do PC host."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хост-ПК сообщил о критической ошибке кодирования видео. \n \nПопробуйте выключить HDR, изменить разрешение стрима или разрешение экрана на хост-ПК."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Värddatorn rapporterade ett allvarligt fel i videokodningen. \n \nFörsök att inaktivera HDR-läget, ändra streamingupplösningen eller ändra värddatorns skärmupplösning."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "புரவலன் பிசி ஒரு அபாயகரமான வீடியோ குறியாக்க பிழையை அறிவித்தது.\n\n எச்டிஆர் பயன்முறையை முடக்க முயற்சிக்கவும், ச்ட்ரீமிங் தீர்மானத்தை மாற்றவும் அல்லது உங்கள் புரவலன் கணினியின் காட்சி தெளிவுத்திறனை மாற்றவும் முயற்சிக்கவும்."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana bilgisayar önemli bir video kodlama hatası bildirdi. \n \nHDR kipi devre dışı bırakmayı, akış çözünürlüğünü değiştirmeyi veya ana bilgisayarın ekran çözünürlüğünü değiştirmeyi deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Головний комп'ютер повідомив про фатальну помилку кодування відео. \n \nСпробуйте вимкнути режим HDR, змінити роздільну здатність потокового відео або змінити роздільну здатність дисплея головного комп'ютера."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PC chủ đã gặp lỗi mã hoá video nghiêm trọng. \n \nHãy thử tắt chế độ HDR, đổi độ phân giải stream, hoặc đổi độ phân giải màn hình PC chủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机 PC 报告了致命的视频编码错误。 \n \n尝试禁用 HDR 模式、更改流分辨率或更改主机 PC 的显示分辨率。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機電腦回報了一個嚴重的視訊編碼錯誤。 \n \n嘗試停用 HDR 模式，變更串流解析度，或變更您的主機電腦的顯示器解析度。"
          }
        }
      }
    },
