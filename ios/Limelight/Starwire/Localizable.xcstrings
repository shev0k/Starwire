    "summary_checkbox_usb_bind_all" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използване на USB драйвера на Starwire за всички поддържани контролери, дори ако е налична собствена поддръжка на контролери за Xbox"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzwingt die Verwendung von Starwires USB Treiber für alle Xbox kompatiblen Controller"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε το πρόγραμμα οδήγησης USB του Starwire για όλα τα υποστηριζόμενα gamepad, ακόμα και αν υπάρχει υποστήριξη εγγενούς ελεγκτή Xbox"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Starwire's USB driver for all supported gamepads, even if native Xbox controller support is present"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar el controlador de USB de Starwire para todos los mandos soportados, incluso si el control de Xbox se encuentra presente"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser le pilote USB de Starwire pour toutes les manettes prises en charge, même si l'appareil supporte nativement celles-ci"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Starwire USB-illesztőprogramjának használata az összes támogatott játékvezérlőhöz, még akkor is, ha natív Xbox-vezérlő támogatás van jelen"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan driver USB Starwire untuk semua gamepad yang didukung, meskipun ada dukungan pengontrol Xbox asli"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forza i driver USB di Starwire di assumere il controllo su tutti i controller Xbox supportati"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox 컨트롤러를 기본으로 지원하는 경우에도 지원되는 모든 컨트롤러에 Starwire의 USB 드라이버를 사용합니다"
          }
        },
        "nb" : {
